@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="empty-state">
    <div class="display-4">!</div>
    <h1>Something went wrong</h1>
    <p class="text-muted">The request could not be completed. Please return to the dashboard and try again.</p>
    @if (Model.ShowRequestId) { <p><code>@Model.RequestId</code></p> }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
