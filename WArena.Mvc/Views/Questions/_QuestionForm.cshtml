@model QuestionFormViewModel
<div class="form-card wide"><h1>@ViewData["Title"]</h1><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-md-4"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"><option value="0">Choose category</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div><div class="col-12"><label asp-for="Prompt" class="form-label"></label><textarea asp-for="Prompt" class="form-control" rows="4"></textarea><span asp-validation-for="Prompt" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select" id="questionType"></select></div><div class="col-md-4"><label asp-for="Difficulty" class="form-label"></label><select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<Difficulty>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Points" class="form-label"></label><input asp-for="Points" class="form-control" /><span asp-validation-for="Points" class="text-danger"></span></div><div class="col-12"><label asp-for="CorrectAnswer" class="form-label"></label><input asp-for="CorrectAnswer" class="form-control" /><span asp-validation-for="CorrectAnswer" class="text-danger"></span></div><div id="choiceOptions" class="col-12"><div class="row g-3"><div class="col-md-6"><label asp-for="OptionA" class="form-label"></label><input asp-for="OptionA" class="form-control" /></div><div class="col-md-6"><label asp-for="OptionB" class="form-label"></label><input asp-for="OptionB" class="form-control" /></div><div class="col-md-6"><label asp-for="OptionC" class="form-label"></label><input asp-for="OptionC" class="form-control" /></div><div class="col-md-6"><label asp-for="OptionD" class="form-label"></label><input asp-for="OptionD" class="form-control" /></div></div><div class="form-text">For multiple choice, the correct answer must exactly match one option.</div></div></div><div class="mt-4"><button class="btn btn-primary" type="submit">Save</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></div>
