@model QuestionSearchViewModel
@{ ViewData["Title"] = "Questions"; }
<div class="section-heading"><div><h1>Questions</h1><p>Pick any question to practice, or filter the question bank.</p></div>@if(User.IsInRole("Admin") || User.IsInRole("Teacher")){<a class="btn btn-success" asp-action="Create">New question</a>}</div>
<form method="get" class="filter-panel mb-4"><div class="row g-3"><div class="col-md-4"><label class="form-label">Search</label><input name="search" value="@Model.Search" class="form-control" placeholder="Title or question text" /></div><div class="col-md-3"><label class="form-label">Category</label><select name="categoryId" class="form-select"><option value="">All categories</option>@foreach(var option in Model.Categories){<option value="@option.Value" selected="@option.Selected">@option.Text</option>}</select></div><div class="col-md-2"><label class="form-label">Difficulty</label><select name="difficulty" class="form-select"><option value="">All</option>@foreach(var d in Enum.GetValues<Difficulty>()){<option value="@d" selected="@(Model.Difficulty == d)">@d</option>}</select></div><div class="col-md-1"><label class="form-label">Min XP</label><input name="minPoints" type="number" value="@Model.MinPoints" class="form-control" /></div><div class="col-md-1"><label class="form-label">Max XP</label><input name="maxPoints" type="number" value="@Model.MaxPoints" class="form-control" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Go</button></div></div></form>
@if(!Model.Questions.Any()){<div class="empty-state"><h2>No questions found</h2><p>Try changing the filters.</p></div>}else{<div class="row g-4">@foreach(var q in Model.Questions){<div class="col-md-6 col-xl-4"><article class="content-card h-100"><div class="d-flex justify-content-between gap-2"><span class="pill">@q.Category?.Name</span><span class="difficulty @q.Difficulty.ToString().ToLowerInvariant()">@q.Difficulty</span></div><div class="d-flex justify-content-between align-items-start gap-2"><h3>@q.Title</h3>@if(Model.CompletedQuestionIds.Contains(q.Id)){<span class="badge bg-success-subtle text-success border border-success-subtle"><span aria-hidden="true">&#10003;</span> Completed</span>}</div><p>@q.Prompt</p><div class="card-meta"><span>@q.Points XP</span><span>@(q.Type == QuestionType.MultipleChoice ? "Multiple choice" : "Short answer")</span></div><div class="d-flex gap-2 flex-wrap mt-auto"><a class="btn btn-primary" asp-controller="Play" asp-action="Question" asp-route-id="@q.Id">Practice</a>@if(User.IsInRole("Admin") || User.IsInRole("Teacher")){<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@q.Id">Edit</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@q.Id">Delete</a>}</div></article></div>}</div>}
