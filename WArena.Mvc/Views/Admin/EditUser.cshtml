@model AdminEditUserViewModel
@{ ViewData["Title"] = "Edit User"; }
<div class="form-page">
    <h1>Edit user</h1>
    <p class="text-muted">Change the username, role, or set a new password.</p>
    <div class="form-card">
        <form asp-action="EditUser" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label class="form-label">Email</label><input class="form-control" value="@Model.Email" disabled /></div>
            <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Student</option><option>Teacher</option><option>Admin</option></select><span asp-validation-for="Role" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><div class="form-text">Leave blank to keep the current password. Use at least 8 characters, including an uppercase letter, a lowercase letter, a number and a special character.</div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Users">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
