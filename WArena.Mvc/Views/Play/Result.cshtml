@model AnswerResultViewModel
@{ ViewData["Title"] = "Result"; }
<div class="result-card">@if(Model.IsCorrect){<div class="result-icon correct">✓</div><h1>Correct!</h1>@if(Model.PointsEarned > 0){<p class="xp-earned">+@Model.PointsEarned XP</p>}else{<p class="text-muted">Correct! This question has no XP reward configured.</p>}}else{<div class="result-icon incorrect">×</div><h1>Not quite</h1><p class="text-muted">Review the topic and try again.</p>}<p>Your answer: <strong>@Model.SubmittedAnswer</strong></p><p class="small text-muted">Total XP: @Model.TotalXp</p><div class="d-flex justify-content-center gap-2 flex-wrap">@if(Model.NextQuestionId.HasValue){<a class="btn btn-primary" asp-action="Question" asp-route-id="@Model.NextQuestionId" asp-route-setId="@Model.ChallengeSetId" asp-route-index="@Model.NextQuestionIndex">Next question</a>}else if(Model.ChallengeSetId.HasValue){<a class="btn btn-success" asp-controller="ChallengeSets" asp-action="Details" asp-route-id="@Model.ChallengeSetId">Set complete</a>}<a class="btn btn-outline-secondary" asp-controller="Questions" asp-action="Index">Question bank</a></div></div>
