@model PlayQuestionViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="play-shell"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="pill">@Model.Category</span> <span class="difficulty @Model.Difficulty.ToString().ToLowerInvariant()">@Model.Difficulty</span>@if(Model.IsCompleted){<span class="badge text-bg-secondary">Completed</span>}</div>@if(Model.ChallengeSetId.HasValue){<span class="text-muted">Question @(Model.QuestionIndex + 1) of @Model.TotalQuestions</span>}</div><article class="play-card"><h1>@Model.Title</h1><p class="question-prompt">@Model.Prompt</p><form asp-action="Submit" method="post"><input asp-for="QuestionId" type="hidden" /><input asp-for="ChallengeSetId" type="hidden" /><input asp-for="QuestionIndex" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>@if(Model.Type == QuestionType.MultipleChoice){<div class="answer-options">@foreach(var option in Model.Options){<label class="answer-option"><input asp-for="Answer" type="radio" value="@option" /><span>@option</span></label>}</div>}else{<div class="mb-3"><label asp-for="Answer" class="form-label">Your answer</label><input asp-for="Answer" class="form-control form-control-lg" autocomplete="off" /></div>}<span asp-validation-for="Answer" class="text-danger d-block mb-3"></span><div class="d-flex justify-content-between align-items-center"><strong class="xp-label">@if(Model.IsCompleted){<text>Reduced XP on retry</text>}else{<text>Earn @Model.Points XP for your first correct answer.</text>}</strong><button class="btn btn-primary btn-lg" type="submit">Submit answer</button></div></form></article></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
