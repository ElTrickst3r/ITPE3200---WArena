@model ChallengeSetFormViewModel
<div class="form-card wide"><h1>@ViewData["Title"]</h1><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="form-check form-switch mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div><h2 class="h5">Choose questions</h2><p class="text-muted">Select the questions you want to include. Questions can be used in multiple sets.</p><div class="question-picker">@foreach(var q in Model.AvailableQuestions){<label class="picker-item"><input class="form-check-input" type="checkbox" name="QuestionIds" value="@q.Id" checked="@(Model.QuestionIds.Contains(q.Id))" /><span><strong>@q.Title</strong><small>@q.Category?.Name · @q.Difficulty · @q.Points XP</small></span></label>}</div><span asp-validation-for="QuestionIds" class="text-danger"></span><div class="mt-4"><button class="btn btn-primary" type="submit">Save set</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></div>
