@model ChallengeSetSearchViewModel
@{ ViewData["Title"] = "Challenge Sets"; }
<div class="section-heading"><div><h1>Challenge sets</h1><p>Complete a group of related questions.</p></div>@if(User.IsInRole("Admin") || User.IsInRole("Teacher")){<a class="btn btn-success" asp-action="Create">New set</a>}</div>
<form method="get" class="filter-panel mb-4"><div class="row g-3"><div class="col-md-6"><label class="form-label">Search</label><input class="form-control" name="search" value="@Model.Search" placeholder="Name or description" /></div><div class="col-md-3"><label class="form-label">Minimum questions</label><input class="form-control" name="minQuestions" type="number" min="1" value="@Model.MinQuestions" /></div>@if(User.IsInRole("Admin") || User.IsInRole("Teacher")){<div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="isPublished"><option value="">All</option><option value="true" selected="@(Model.IsPublished == true)">Published</option><option value="false" selected="@(Model.IsPublished == false)">Draft</option></select></div>}<div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Go</button></div></div></form>
<div class="row g-4">@foreach(var set in Model.ChallengeSets){<div class="col-md-6 col-xl-4"><article class="content-card h-100"><div class="d-flex justify-content-between"><span class="pill">@set.ChallengeSetQuestions.Count questions</span>@if(!set.IsPublished){<span class="badge text-bg-warning">Draft</span>}</div><h3>@set.Name</h3><p>@set.Description</p><div class="card-meta"><span>@set.ChallengeSetQuestions.Sum(x => x.Question?.Points ?? 0) possible XP</span></div><div class="d-flex gap-2 flex-wrap mt-auto"><a class="btn btn-primary" asp-action="Details" asp-route-id="@set.Id">Open</a>@if(User.IsInRole("Admin") || User.IsInRole("Teacher")){<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@set.Id">Edit</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@set.Id">Delete</a>}</div></article></div>}</div>
