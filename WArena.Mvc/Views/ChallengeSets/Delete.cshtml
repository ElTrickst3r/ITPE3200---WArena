@model ChallengeSet
@{ ViewData["Title"] = "Delete challenge set"; }
<div class="form-card"><h1>Delete challenge set</h1><p>Delete <strong>@Model.Name</strong> and its question links?</p><p class="text-muted">The questions themselves will not be deleted.</p><form method="post" asp-action="Delete"><input name="id" value="@Model.Id" type="hidden" /><button class="btn btn-danger" type="submit">Delete</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></form></div>
